APP_NAME=EkonomiLokal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ekonomi_lokal
DB_USERNAME=root
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ekonomilokal.id"
MAIL_FROM_NAME="${APP_NAME}"

# Wajib HS256 (bukan RS256) kecuali kamu sudah generate keypair lewat `php artisan jwt:keys`.
# JWT_SECRET diisi otomatis oleh `php artisan jwt:secret`, jangan diisi manual.
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160

MINIO_ENDPOINT=http://minio:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=ekonomi-lokal

# Isi dengan key dari dashboard Midtrans (sandbox) kalau mau fitur pembayaran jalan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Isi dengan API key dari Google AI Studio kalau mau fitur AI chat jalan.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Isi kalau mau push notification (FCM/APNs) jalan.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

RATE_LIMIT_PER_MINUTE=60
