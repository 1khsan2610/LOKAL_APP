# Docker Environment Configuration

APP_NAME="LOKAL APP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lokal_app
DB_USERNAME=appuser
DB_PASSWORD=password
DB_ROOT_PASSWORD=root

# Backend Port
BACKEND_PORT=8000

# Frontend Web Port
FRONTEND_WEB_PORT=3000

# React App API URL
REACT_APP_API_URL=http://localhost:8000/api

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcasting
BROADCAST_DRIVER=log
BROADCAST_HOST=localhost
BROADCAST_PORT=6001
BROADCAST_KEY=
BROADCAST_SECRET=

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Mail
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lokal.app"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Secret
JWT_SECRET=

# Twilio (if used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Midtrans (if used)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# ML Service (Python/FastAPI)
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT=30
ML_SERVICE_API_KEY=
